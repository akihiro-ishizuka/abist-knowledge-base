.venv/
venv/
.env/

# Secrets and local config
.env
.env.*
!.env.example

# Application data (regenerable / local)
data/
docs/
reports/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# M9カットオーバー: migrate swap で組み込まれた旧システムのコンテンツ。
# docs/ 同様、これはナレッジベースのデータであってこのプロジェクトの
# ソースコードではない(§4: 旧システムには docs/ の外にも実データがあった)。
# tools/ は tools/visualize/(このプロジェクトのソース)と旧システムの
# コンテンツが混在するため、旧コンテンツのパスだけを個別に無視する。
bk/
# Keep scripts/ ignored for cutover scratch, but track the Windows bootstrap.
scripts/*
!scripts/bootstrap.bat
work/
tools/*.md
tools/issue_bodies/
tools/knowledge-curator/

# Caches and models
.cache/
__model_cache__/
*.onnx

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
Desktop.ini

# Logs and temp
*.log
tmp/
temp/
.temp/

# Manim / media outputs
media/

# Agent scratch (subagent-driven-development ledger, briefs, review packages)
.superpowers/

# Agent worktrees (scratch)
.claude/worktrees/

# Pre-force-sync backups (local safety copies)
backup/

# Project-local agent worktrees
.worktrees/
